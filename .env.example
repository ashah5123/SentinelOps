# SentinelOps environment configuration template.
# Copy to .env and fill in local values. Never commit a real .env file.
# All values below are non-functional placeholders.

# ---- General ----
ENVIRONMENT=local
LOG_LEVEL=info

# ---- PostgreSQL / pgvector ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sentinelops
POSTGRES_USER=sentinelops
POSTGRES_PASSWORD=change-me

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379

# ---- MinIO (S3-compatible object storage) ----
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=change-me
MINIO_ROOT_PASSWORD=change-me
MINIO_BUCKET=sentinelops-artifacts

# ---- Redpanda (Kafka-compatible) ----
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ---- Keycloak (OAuth2 / OIDC) ----
KEYCLOAK_ISSUER_URL=http://localhost:8081/realms/sentinelops
KEYCLOAK_CLIENT_ID=sentinelops-app
KEYCLOAK_CLIENT_SECRET=change-me

# ---- Observability ----
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
PROMETHEUS_URL=http://localhost:9090
GRAFANA_URL=http://localhost:3001
LOKI_URL=http://localhost:3100
TEMPO_URL=http://localhost:3200

# ---- Local LLM inference (Ollama) ----
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3

# ---- Optional AWS (documentation only, not provisioned by default) ----
# AWS_REGION=
# AWS_PROFILE=
