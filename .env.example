# SentinelOps environment configuration template.
#
# Setup: copy this file to .env in the repository root and replace every
# "change-me-local-dev-only" placeholder with your own local-only value.
#   cp .env.example .env
#
# .env is git-ignored and must never be committed. Every value below is a
# non-functional, clearly-labeled development placeholder — never a real
# secret. Do not print the contents of .env in logs, status output, or
# test output.

# ---- General ----
ENVIRONMENT=local
LOG_LEVEL=info

# ---- PostgreSQL / pgvector ----
# POSTGRES_USER/PASSWORD are the bootstrap credentials used only by the
# Postgres container's own initialization process. Application services
# connect as POSTGRES_APP_USER instead, which is created as a
# non-superuser role — see infrastructure/docker/postgres/init/.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sentinelops
POSTGRES_USER=sentinelops_bootstrap
POSTGRES_PASSWORD=change-me-local-dev-only
POSTGRES_APP_USER=sentinelops_app
POSTGRES_APP_PASSWORD=change-me-local-dev-only

# ---- Redis (cache and coordination store — not the system of record) ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change-me-local-dev-only

# ---- MinIO (S3-compatible object storage) ----
# Buckets (runbooks, incident-artifacts, postmortems) are created
# automatically by the minio-bucket-init container; see
# infrastructure/docker/minio/init-buckets.sh.
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=change-me-local-dev-only
MINIO_ROOT_PASSWORD=change-me-local-dev-only

# ---- Redpanda (Kafka-compatible event streaming) ----
# KAFKA_BOOTSTRAP_SERVERS is the host-reachable address (outside Docker);
# services running inside the sentinelops-net Docker network should use
# redpanda:9092 instead.
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
REDPANDA_KAFKA_EXTERNAL_PORT=19092
REDPANDA_ADMIN_PORT=9644
REDPANDA_CONSOLE_PORT=8080
REDPANDA_TOPIC_PARTITIONS=3
REDPANDA_TOPIC_RETENTION_MS=604800000
REDPANDA_TOPIC_MAX_MESSAGE_BYTES=1048576

# Redpanda Console is optional (resource-conservation). It only starts
# when the "console" Compose profile is active. To disable it, set:
#   COMPOSE_PROFILES=
# The incident-service (Phase 3) is also optional and starts only when the
# "app" profile is active, e.g. COMPOSE_PROFILES=console,app.
COMPOSE_PROFILES=console

# ---- Incident Service (Phase 3) ----
# SECURITY NOTICE: the incident service implements no authentication or
# authorization yet. Never expose INCIDENT_SERVICE_PORT beyond localhost.
INCIDENT_SERVICE_PORT=8081

# ---- Telemetry Correlation Service (Phase 5) ----
# SECURITY NOTICE: implements no authentication or authorization yet. Never
# expose TELEMETRY_CORRELATION_SERVICE_PORT beyond localhost. See
# docs/development/telemetry-correlation.md (or the service's own README) for
# details on each setting below.
TELEMETRY_CORRELATION_SERVICE_PORT=8082
# Comma-separated list of services this instance polls Prometheus/Loki/Tempo for.
TELEMETRY_MONITORED_SERVICES=incident-service
TELEMETRY_POLLING_INTERVAL=30s
TELEMETRY_QUERY_WINDOW=60s
TELEMETRY_OVERLAP_WINDOW=15s
TELEMETRY_MAX_RECORDS_PER_CYCLE=2000
TELEMETRY_BATCH_SIZE=200
TELEMETRY_CONSUMER_MAX_RETRIES=5
# Correlation-engine settings: how far around an incident's detection time to
# look, and how many dependency hops (upstream/downstream) to traverse.
CORRELATION_WINDOW=15m
CORRELATION_MAX_DEPENDENCY_DEPTH=1
CORRELATION_MAX_EVIDENCE_RESULTS=25

# ---- Keycloak (OAuth2 / OIDC) ----
KEYCLOAK_ISSUER_URL=http://localhost:8081/realms/sentinelops
KEYCLOAK_CLIENT_ID=sentinelops-app
KEYCLOAK_CLIENT_SECRET=change-me

# ---- Observability (Phase 4) ----
# The observability stack (OpenTelemetry Collector, Prometheus, Grafana, Loki, Tempo,
# Alertmanager) only starts when the "observability" Compose profile is active, e.g.
#   COMPOSE_PROFILES=console,app,observability
# See docs/development/observability.md for the full local endpoint list and data flow.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_COLLECTOR_GRPC_PORT=4317
OTEL_COLLECTOR_HTTP_PORT=4318
# Development-only variant with an added debug/console exporter; see
# infrastructure/docker/observability/otel-collector/otel-collector-config.dev.yaml.
OTEL_COLLECTOR_CONFIG_FILE=otel-collector-config.yaml
PROMETHEUS_URL=http://localhost:9090
PROMETHEUS_PORT=9090
GRAFANA_URL=http://localhost:3001
GRAFANA_PORT=3001
# Local-only Grafana admin credentials; never reused outside this environment.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-local-dev-only
LOKI_URL=http://localhost:3100
LOKI_PORT=3100
TEMPO_URL=http://localhost:3200
TEMPO_PORT=3200
ALERTMANAGER_URL=http://localhost:9093
ALERTMANAGER_PORT=9093

# ---- Local LLM inference (Ollama) ----
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3

# ---- Optional AWS (documentation only, not provisioned by default) ----
# AWS_REGION=
# AWS_PROFILE=
