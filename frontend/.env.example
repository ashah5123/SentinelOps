# SentinelOps operator console configuration template.
# Copy to .env.local (Vite convention; already git-ignored) and adjust if your local ports differ.
# Every value here is a public, non-secret client configuration value — an OIDC public-client SPA
# has no client secret to protect; PKCE is what secures the authorization code exchange instead.

VITE_KEYCLOAK_AUTHORITY=http://localhost:8180/realms/sentinelops
VITE_KEYCLOAK_CLIENT_ID=sentinelops-frontend
VITE_API_BASE_URL=http://localhost:8081
