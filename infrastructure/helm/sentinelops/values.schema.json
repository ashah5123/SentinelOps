{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "sentinelops Helm chart values",
  "type": "object",
  "required": ["global", "incidentService", "telemetryCorrelationService"],
  "properties": {
    "global": {
      "type": "object",
      "required": ["namespace", "environment"],
      "properties": {
        "namespace": { "type": "string", "minLength": 1 },
        "environment": { "type": "string", "enum": ["dev", "staging", "production"] },
        "imageRegistry": { "type": "string" },
        "imagePullSecrets": { "type": "array" }
      }
    },
    "incidentService": { "$ref": "#/$defs/service" },
    "telemetryCorrelationService": { "$ref": "#/$defs/service" },
    "securityContext": { "type": "object" },
    "containerSecurityContext": {
      "type": "object",
      "properties": {
        "readOnlyRootFilesystem": { "type": "boolean", "const": true },
        "allowPrivilegeEscalation": { "type": "boolean", "const": false }
      }
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "automountServiceAccountToken": { "type": "boolean" }
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "allowedEgressPorts": { "type": "array", "items": { "type": "integer" } }
      }
    },
    "ingress": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "host": { "type": "string" }
      }
    },
    "externalDependencies": { "type": "object" }
  },
  "$defs": {
    "service": {
      "type": "object",
      "required": ["enabled", "image", "replicaCount", "resources", "containerPort"],
      "properties": {
        "enabled": { "type": "boolean" },
        "replicaCount": { "type": "integer", "minimum": 1 },
        "containerPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "image": {
          "type": "object",
          "required": ["repository", "tag"],
          "properties": {
            "repository": { "type": "string", "minLength": 1 },
            "tag": { "type": "string", "minLength": 1 },
            "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
          }
        },
        "resources": {
          "type": "object",
          "required": ["requests", "limits"],
          "description": "Every workload must declare both requests and limits — an unbounded container is a scheduling and noisy-neighbor risk."
        },
        "autoscaling": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "minReplicas": { "type": "integer", "minimum": 1 },
            "maxReplicas": { "type": "integer", "minimum": 1 }
          }
        }
      }
    }
  }
}
